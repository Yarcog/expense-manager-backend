# Copia este archivo como secrets.properties (en la raíz del proyecto) y pon tus propios valores.
# secrets.properties no se sube a git.

# Clave para firmar los JWT: mínimo 32 caracteres
JWT_SECRET=cambia-esto-por-una-clave-larga-de-al-menos-32-caracteres

# Código para registrar usuarios ADMIN
ADMIN_SECRET_CODE=cambia-esto-por-tu-codigo-de-admin
